---
export const prerender = false;

import AppLayout from "../layouts/AppLayout.astro";
import { prisma } from "../lib/prisma";

const controladores = await prisma.controlador.findMany({
  where: { activo: true },
  orderBy: { nombre: "asc" },
});
---

<AppLayout title="Control de errores">
  <section class="panel">
    <div class="header">
      <p class="kicker">Control operativo</p>
      <h1>Carga de relevamiento</h1>
      <p class="description">
        Registrá uno o varios SKUs dentro del mismo caso de error.
      </p>
    </div>

    <form id="relevamiento-form" class="form-card">
      <section class="section-block">
        <h2>Datos generales</h2>

        <div class="form-grid">
          <label>
            Mes operativo
            <input
              name="mesOperativo"
              placeholder="Mes de órdenes armadas"
              required
            />
          </label>

          <label>
            Remito
            <input name="remito" placeholder="Número de remito" required />
          </label>

          <label>
            CBI
            <input name="cbi" placeholder="Código CBI" required />
          </label>
          <label>
            Controlado por
            <select name="controladorId" required>
              <option value="">Seleccionar</option>
              {
                controladores.map((c) => (
                  <option value={c.id}>{c.nombre}</option>
                ))
              }
            </select>
          </label>

          <label class="full">
            Observación general
            <textarea
              name="observacion"
              rows="3"
              placeholder="Ej: Producto cambiado, diferencia entre pedido y físico..."
            ></textarea>
          </label>
        </div>
      </section>

      <section class="section-block">
        <div class="items-header">
          <div>
            <h2>Productos involucrados</h2>
            <p>
              Cargá un SKU por línea. Cada uno puede ser faltante, sobrante o
              sin error/base mal cargada.
            </p>
          </div>

          <button id="btn-agregar-item" type="button" class="btn-secondary">
            + Agregar SKU
          </button>
        </div>

        <div id="items-container" class="items-container"></div>
      </section>

      <div class="actions">
        <p id="status"></p>
        <button id="btn-guardar" type="button">Guardar caso</button>
      </div>
    </form>
  </section>

  <template id="item-template">
    <article class="item-card">
      <div class="item-top">
        <div>
          <span class="item-label">Ítem</span>
          <strong class="item-title">SKU del caso</strong>
        </div>

        <button type="button" class="btn-remove">Eliminar</button>
      </div>

      <div class="item-grid">
        <label>
          SKU
          <input
            data-field="skuCodigo"
            placeholder="Ej: 06188584"
            autocomplete="off"
            required
          />
        </label>

        <label>
          Resultado
          <select data-field="resultadoControl" required>
            <option value="">Seleccionar</option>
            <option value="FALTANTE">Faltante</option>
            <option value="SOBRANTE">Sobrante</option>
            <option value="SIN_ERROR_BASE">Sin error / Base mal cargada</option>
          </select>
        </label>

        <label>
          Cantidad
          <input data-field="cantidad" type="number" min="1" value="1" />
        </label>
      </div>

      <div class="sku-info hidden">
        <div>
          <span>Descripción</span>
          <strong data-info="descripcion">-</strong>
        </div>

        <div>
          <span>Posición</span>
          <strong data-info="posicion">-</strong>
        </div>

        <div>
          <span>Estación</span>
          <strong data-info="estacion">-</strong>
        </div>
        <div>
          <span>Picker</span>
          <strong data-info="picker">-</strong>
        </div>
        <div>
          <span>Peso</span>
          <strong data-info="peso">-</strong>
        </div>

        <div>
          <span>Volumen</span>
          <strong data-info="volumen">-</strong>
        </div>
      </div>
    </article>
  </template>
</AppLayout>

<script>
  const form = document.querySelector("#relevamiento-form");
  const statusEl = document.querySelector("#status");
  const submitBtn = document.querySelector("#btn-guardar");
  const addItemBtn = document.querySelector("#btn-agregar-item");
  const itemsContainer = document.querySelector("#items-container");
  const template = document.querySelector("#item-template");

  let itemCounter = 0;

  function setStatus(message, type = "") {
    if (!(statusEl instanceof HTMLParagraphElement)) return;

    statusEl.textContent = message;
    statusEl.className = type;
  }

  function limpiarInfoSku(card) {
    const info = card.querySelector(".sku-info");

    if (info instanceof HTMLElement) {
      info.classList.add("hidden");
    }
    card.querySelector('[data-info="picker"]').textContent = "-";
    card.querySelector('[data-info="descripcion"]').textContent = "-";
    card.querySelector('[data-info="posicion"]').textContent = "-";
    card.querySelector('[data-info="estacion"]').textContent = "-";
    card.querySelector('[data-info="peso"]').textContent = "-";
    card.querySelector('[data-info="volumen"]').textContent = "-";
  }

  async function buscarSku(card, codigo) {
    if (!codigo || codigo.length < 5) {
      limpiarInfoSku(card);
      return;
    }

    try {
      const res = await fetch(`/api/skus/${encodeURIComponent(codigo)}`);

      const data = await res.json();

      if (!res.ok) {
        limpiarInfoSku(card);

        setStatus(data.error || `SKU ${codigo} no encontrado.`, "error");

        return;
      }

      const info = card.querySelector(".sku-info");

      if (info instanceof HTMLElement) {
        info.classList.remove("hidden");
      }

      card.querySelector('[data-info="descripcion"]').textContent =
        data.descripcion || "-";

      card.querySelector('[data-info="posicion"]').textContent =
        data.posicion || "Sin posición";

      card.querySelector('[data-info="estacion"]').textContent =
        data.estacion || "-";

      // 👇 NUEVO

      card.querySelector('[data-info="picker"]').textContent =
        data.pickerDetectado?.nombre ?? "Sin asignar";

      // 👇 YA EXISTÍAN

      card.querySelector('[data-info="peso"]').textContent =
        data.pesoBranch ?? "-";

      card.querySelector('[data-info="volumen"]').textContent =
        data.cubicaje ?? "-";

      setStatus("");
    } catch (error) {
      limpiarInfoSku(card);

      setStatus(
        error instanceof Error ? error.message : "Error consultando SKU.",
        "error",
      );
    }
  }

  function actualizarTitulosItems() {
    const cards = document.querySelectorAll(".item-card");

    cards.forEach((card, index) => {
      const title = card.querySelector(".item-title");

      if (title) {
        title.textContent = `Producto ${index + 1}`;
      }

      const removeBtn = card.querySelector(".btn-remove");

      if (removeBtn instanceof HTMLButtonElement) {
        removeBtn.disabled = cards.length === 1;
      }
    });
  }

  function agregarItem() {
    if (!(template instanceof HTMLTemplateElement)) return;
    if (!(itemsContainer instanceof HTMLElement)) return;

    itemCounter += 1;

    const clone = template.content.cloneNode(true);
    const card = clone.querySelector(".item-card");

    if (!(card instanceof HTMLElement)) return;

    const skuInput = card.querySelector('[data-field="skuCodigo"]');
    const removeBtn = card.querySelector(".btn-remove");

    let timer;

    if (skuInput instanceof HTMLInputElement) {
      skuInput.addEventListener("input", () => {
        clearTimeout(timer);

        timer = window.setTimeout(() => {
          buscarSku(card, skuInput.value.trim());
        }, 400);
      });

      skuInput.addEventListener("blur", () => {
        buscarSku(card, skuInput.value.trim());
      });
    }

    removeBtn?.addEventListener("click", () => {
      card.remove();
      actualizarTitulosItems();
    });

    itemsContainer.appendChild(clone);
    actualizarTitulosItems();
  }

  function obtenerValorGeneral(nombre) {
    if (!(form instanceof HTMLFormElement)) return "";

    const campo = form.elements.namedItem(nombre);

    if (
      campo instanceof HTMLInputElement ||
      campo instanceof HTMLSelectElement ||
      campo instanceof HTMLTextAreaElement
    ) {
      return campo.value.trim();
    }

    return "";
  }

  function obtenerItems() {
    const cards = document.querySelectorAll(".item-card");

    return Array.from(cards).map((card) => {
      const skuCodigo = card.querySelector('[data-field="skuCodigo"]')?.value;
      const resultadoControl = card.querySelector(
        '[data-field="resultadoControl"]',
      )?.value;
      const cantidad = card.querySelector('[data-field="cantidad"]')?.value;

      return {
        skuCodigo: String(skuCodigo || "").trim(),
        resultadoControl: String(resultadoControl || ""),
        cantidad: Number(cantidad || 0),
      };
    });
  }

  addItemBtn?.addEventListener("click", () => {
    agregarItem();
  });

  submitBtn?.addEventListener("click", async () => {
    const payload = {
      mesOperativo: obtenerValorGeneral("mesOperativo"),
      remito: obtenerValorGeneral("remito"),
      cbi: obtenerValorGeneral("cbi"),
      controladorId: Number(obtenerValorGeneral("controladorId")),
      observacion: obtenerValorGeneral("observacion"),
      items: obtenerItems(),
    };

    if (
      !payload.mesOperativo ||
      !payload.remito ||
      !payload.cbi ||
      !payload.controladorId
    ) {
      setStatus("Completá los datos generales obligatorios.", "error");
      return;
    }

    if (!payload.items.length) {
      setStatus("Agregá al menos un SKU.", "error");
      return;
    }

    try {
      const res = await fetch("/api/relevamientos/casos", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const raw = await res.text();
      const data = raw ? JSON.parse(raw) : {};

      if (res.ok) {
        setStatus("Caso guardado correctamente.", "success");

        if (form instanceof HTMLFormElement) {
          form.reset();
        }

        if (itemsContainer instanceof HTMLElement) {
          itemsContainer.innerHTML = "";
        }

        agregarItem();
      } else {
        setStatus(data.error || "Error al guardar el caso.", "error");
      }
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : "Error de conexión.",
        "error",
      );
    }
  });

  agregarItem();
</script>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: #f3f4f6;
    color: #111827;
  }

  .panel {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 28px;
  }

  .kicker {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #db2777;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .description {
    max-width: 760px;
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: #64748b;
  }

  .form-card {
    width: 100%;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 28px;
    padding: 30px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(12px);
  }

  .section-block {
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid #e2e8f0;
  }

  .section-block:last-of-type {
    margin-bottom: 0;
  }

  .section-block h2 {
    margin: 0 0 18px;
    font-size: 22px;
    color: #0f172a;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    color: #334155;
  }

  input,
  select,
  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    padding: 13px 15px;
    font: inherit;
    font-weight: 600;
    color: #0f172a;
    background: #f8fafc;
    outline: none;
    transition: 0.2s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: #94a3b8;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #db2777;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(219, 39, 119, 0.12);
  }

  textarea {
    resize: vertical;
    min-height: 100px;
  }

  .full {
    grid-column: 1 / -1;
  }

  .items-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .items-header h2 {
    margin: 0;
  }

  .items-header p {
    margin: 6px 0 0;
    color: #64748b;
    font-weight: 600;
  }

  .items-container {
    display: grid;
    gap: 18px;
  }

  .item-card {
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: 18px;
    background: #f8fafc;
  }

  .item-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
  }

  .item-label {
    display: block;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
  }

  .item-title {
    display: block;
    margin-top: 4px;
    font-size: 20px;
    color: #0f172a;
  }

  .item-grid {
    display: grid;

    grid-template-columns:
      1.6fr
      1fr
      120px;

    gap: 14px;
  }

  .sku-info {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
    padding: 16px;
    border-radius: 18px;
    background: white;
    border: 1px solid #e2e8f0;
  }

  .sku-info div {
    display: grid;
    gap: 6px;
  }

  .sku-info span {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
  }

  .sku-info strong {
    font-size: 14px;
    color: #0f172a;
  }

  .hidden {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 28px;
  }

  button {
    border: 0;
    border-radius: 999px;
    padding: 14px 28px;
    font: inherit;
    font-weight: 900;
    color: white;
    background: linear-gradient(135deg, #0f172a, #334155);
    cursor: pointer;
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.22);
    transition: 0.2s ease;
  }

  button:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #db2777, #be185d);
    box-shadow: 0 16px 34px rgba(219, 39, 119, 0.28);
  }

  .btn-secondary {
    background: #e2e8f0;
    color: #0f172a;
    box-shadow: none;
  }

  .btn-remove {
    background: #fee2e2;
    color: #991b1b;
    box-shadow: none;
    padding: 10px 16px;
  }

  .btn-remove:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  #status {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
  }

  :global(.success) {
    color: #047857;
  }

  :global(.error) {
    color: #dc2626;
  }

  @media (max-width: 980px) {
    .form-grid,
    .item-grid,
    .sku-info {
      grid-template-columns: 1fr;
    }

    .items-header,
    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    button {
      width: 100%;
    }
  }
</style>
