---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { prisma } from "../../lib/prisma";

const controladores = await prisma.controlador.findMany({
  where: {
    activo: true,
  },

  orderBy: {
    nombre: "asc",
  },
});
---

<AppLayout title="Nuevo usuario">
  <section class="page">
    <div class="header">
      <p class="kicker">ADMINISTRACIÓN</p>

      <h1>Nuevo usuario</h1>

      <p>Crear un nuevo acceso al sistema.</p>
    </div>

    <form action="/api/usuarios/crear" method="POST" class="card">
      <div class="grid">
        <div class="field">
          <label> Nombre </label>

          <input type="text" name="nombre" required />
        </div>

        <div class="field">
          <label> Email </label>

          <input type="email" name="email" required />
        </div>

        <div class="field">
          <label> Contraseña temporal </label>

          <input type="password" name="password" required minlength="8" />
        </div>

        <div class="field">
          <label> Rol </label>

          <select name="rol" required>
            <option value="ADMIN"> ADMIN </option>

            <option value="SUPERVISOR"> SUPERVISOR </option>

            <option value="CONTROLADOR"> CONTROLADOR </option>

            <option value="CONSULTA"> CONSULTA </option>
          </select>
        </div>

        <div class="field">
          <label> Controlador asociado </label>

          <select name="controladorId">
            <option value=""> Sin asignar </option>

            {
              controladores.map((controlador) => (
                <option value={controlador.id}>{controlador.nombre}</option>
              ))
            }
          </select>
        </div>

        <div class="field checkbox">
          <label>
            <input type="checkbox" name="activo" checked />

            Usuario activo
          </label>
        </div>
      </div>

      <div class="actions">
        <a href="/usuarios" class="btn-secondary"> Cancelar </a>

        <button type="submit" class="btn-primary"> Crear usuario </button>
      </div>
    </form>
  </section>
</AppLayout>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 28px;
  }

  .kicker {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.25em;
    color: #db2777;
  }

  h1 {
    margin: 6px 0;
    font-size: 58px;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .header p {
    color: #64748b;
    font-weight: 600;
  }

  .card {
    padding: 32px;

    background: white;

    border-radius: 28px;

    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
  }

  .grid {
    display: grid;

    gap: 24px;

    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .field {
    display: grid;

    gap: 8px;
  }

  .field label {
    font-size: 13px;

    font-weight: 900;

    color: #64748b;

    text-transform: uppercase;

    letter-spacing: 0.08em;
  }

  input,
  select {
    height: 52px;

    border: none;

    border-radius: 16px;

    padding: 0 18px;

    background: #f8fafc;

    font-size: 15px;
  }

  .checkbox {
    align-self: end;
  }

  .checkbox label {
    display: flex;

    align-items: center;

    gap: 10px;

    text-transform: none;
  }

  .actions {
    display: flex;

    justify-content: flex-end;

    gap: 16px;

    margin-top: 40px;
  }

  .btn-primary {
    height: 50px;

    padding: 0 26px;

    border: none;

    border-radius: 999px;

    background: linear-gradient(135deg, #db2777, #be185d);

    color: white;

    font-weight: 900;

    cursor: pointer;
  }

  .btn-secondary {
    height: 50px;

    padding: 0 26px;

    border-radius: 999px;

    display: flex;

    align-items: center;

    text-decoration: none;

    background: #e2e8f0;

    color: #0f172a;

    font-weight: 900;
  }
</style>
