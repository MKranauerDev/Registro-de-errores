---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { prisma } from "../../lib/prisma";

const usuarios = await prisma.usuario.findMany({
  orderBy: {
    nombre: "asc",
  },
  include: {
    controlador: true,
  },
});
---

<AppLayout title="Usuarios">
  <section class="usuarios-page">
    <div class="header">
      <p class="kicker">Administración</p>

      <div class="header-row">
        <div>
          <h1>Usuarios</h1>
          <p>
            Gestioná accesos, roles y usuarios activos del sistema.
          </p>
        </div>

        <a href="/usuarios/nuevo" class="btn-primary">
          + Nuevo usuario
        </a>
      </div>
    </div>

    <section class="card">
      {
        usuarios.length === 0 ? (
          <p class="empty">No hay usuarios cargados.</p>
        ) : (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Email</th>
                  <th>Rol</th>
                  <th>Controlador asociado</th>
                  <th>Estado</th>
                  <th></th>
                </tr>
              </thead>

              <tbody>
                {usuarios.map((usuario) => (
                  <tr>
                    <td>
                      <strong>{usuario.nombre}</strong>
                    </td>

                    <td>{usuario.email}</td>

                    <td>
                      <span class="badge role">
                        {usuario.rol}
                      </span>
                    </td>

                    <td>{usuario.controlador?.nombre ?? "-"}</td>

                    <td>
                      <span class={usuario.activo ? "badge ok" : "badge off"}>
                        {usuario.activo ? "Activo" : "Inactivo"}
                      </span>
                    </td>

                    <td>
                      <a href={`/usuarios/${usuario.id}`} class="edit-link">
                        Editar
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </section>
</AppLayout>

<style>
  .usuarios-page {
    max-width: 1180px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 28px;
  }

  .kicker {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #db2777;
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.05em;
    color: #0f172a;
  }

  .header p {
    margin: 12px 0 0;
    color: #64748b;
    font-weight: 600;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: linear-gradient(135deg, #db2777, #be185d);
    color: white;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 14px 28px rgba(219, 39, 119, 0.25);
  }

  .card {
    padding: 24px;
    border-radius: 26px;
    background: white;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 15px 14px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
  }

  th {
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  td {
    color: #334155;
    font-weight: 600;
  }

  td strong {
    color: #0f172a;
  }

  .badge {
    display: inline-flex;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
  }

  .role {
    background: #e0e7ff;
    color: #3730a3;
  }

  .ok {
    background: #dcfce7;
    color: #166534;
  }

  .off {
    background: #fee2e2;
    color: #991b1b;
  }

  .edit-link {
    color: #db2777;
    font-weight: 900;
    text-decoration: none;
  }

  .empty {
    color: #64748b;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .header-row {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>