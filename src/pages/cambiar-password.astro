---
export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<main class="page">
  <section class="card">
    <div class="icon">🔒</div>

    <p class="kicker">SEGURIDAD</p>

    <h1>Cambiar contraseña</h1>

    <p class="description">
      Por seguridad, debés definir una nueva contraseña antes de continuar.
    </p>

    {
      error === "no-coincide" && (
        <div class="error-message">Las contraseñas no coinciden.</div>
      )
    }

    {
      error === "minimo" && (
        <div class="error-message">
          La contraseña debe tener al menos 8 caracteres.
        </div>
      )
    }

    <form action="/api/password/cambiar" method="POST" class="form">
      <label>
        Nueva contraseña

        <input type="password" name="password" required minlength="8" />
      </label>

      <label>
        Confirmar contraseña

        <input
          type="password"
          name="confirmarPassword"
          required
          minlength="8"
        />
      </label>

      <button type="submit"> Guardar contraseña </button>
    </form>
  </section>
</main>

<style>
  .page {
    min-height: 100vh;

    display: grid;

    place-items: center;

    padding: 24px;

    background:
      radial-gradient(
        circle at top left,
        rgba(219, 39, 119, 0.18),
        transparent 32%
      ),
      linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);

    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .card {
    width: min(500px, 100%);

    padding: 40px;

    border-radius: 32px;

    background: white;

    box-shadow: 0 24px 65px rgba(15, 23, 42, 0.14);
  }

  .icon {
    width: 62px;

    height: 62px;

    display: grid;

    place-items: center;

    border-radius: 20px;

    background: #fce7f3;

    font-size: 30px;

    margin-bottom: 18px;
  }

  .kicker {
    margin: 0 0 12px;

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 0.22em;

    text-transform: uppercase;

    color: #db2777;
  }

  h1 {
    margin: 0;

    font-size: clamp(38px, 5vw, 48px);

    line-height: 1;

    letter-spacing: -0.05em;

    color: #0f172a;
  }

  .description {
    margin: 18px 0 28px;

    color: #64748b;

    font-size: 16px;

    font-weight: 600;

    line-height: 1.6;
  }

  .form {
    display: grid;

    gap: 20px;
  }

  label {
    display: grid;

    gap: 8px;

    font-size: 14px;

    font-weight: 900;

    color: #334155;
  }

  input {
    height: 54px;

    border: 1px solid #cbd5e1;

    border-radius: 16px;

    padding: 0 18px;

    background: #f8fafc;

    font: inherit;

    font-weight: 700;

    color: #0f172a;
  }

  input:focus {
    outline: none;

    border-color: #db2777;

    box-shadow: 0 0 0 4px rgba(219, 39, 119, 0.15);
  }

  button {
    margin-top: 8px;

    height: 54px;

    border: 0;

    border-radius: 999px;

    background: linear-gradient(135deg, #db2777, #be185d);

    color: white;

    font: inherit;

    font-weight: 900;

    cursor: pointer;

    transition: 0.2s;

    box-shadow: 0 14px 28px rgba(219, 39, 119, 0.24);
  }

  button:hover {
    transform: translateY(-2px);
  }

  .error-message {
    margin-bottom: 18px;

    padding: 14px 16px;

    border-radius: 14px;

    background: #fee2e2;

    color: #991b1b;

    font-weight: 900;
  }

  @media (max-width: 600px) {
    .card {
      padding: 30px;
    }

    h1 {
      font-size: 34px;
    }
  }
</style>
