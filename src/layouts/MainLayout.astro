---
interface Props {
  title?: string;
}

const { title = "Sistema de relevamiento de errores de pickeo" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main>
      <slot />
    </main>
  </body>
</html>
