---
export const prerender = false;

import { getSessionUser } from "../lib/auth";
import { menuPorRol } from "../lib/menu";

const usuario = await getSessionUser(Astro.cookies);
const menu = menuPorRol[usuario?.rol ?? "CONSULTA"];
---

<aside class="sidebar">
  <div class="brand">
    <strong>Control de Errores</strong>
    <span>Pickeo</span>
  </div>

  <nav>
    {menu.map((item) => <a href={item.ruta}>{item.nombre}</a>)}
  </nav>
  <div class="sidebar-footer">
    <div class="user-box">
      <div class="user-name">
        👤 {usuario?.nombre ?? "Usuario"}
      </div>

      <div class="user-role">
        {usuario?.rol ?? ""}
      </div>
    </div>

    <a href="/api/auth/logout" class="logout-btn"> 🚪 Cerrar sesión </a>
  </div>
</aside>

<style is:global>
  .sidebar,
  .sidebar * {
    box-sizing: border-box;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 260px;
    height: 100vh;
    background: #07162b;
    color: white;
    padding: 28px 20px;
    z-index: 9999;

    display: flex;
    flex-direction: column;
  }

  .brand {
    display: grid;
    gap: 4px;
    margin-bottom: 36px;
  }

  .brand strong {
    font-size: 1.15rem;
  }

  .brand span {
    color: #8ea4c8;
    font-size: 0.85rem;
  }

  .sidebar nav {
    flex: 1;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .sidebar a {
    color: #dbe7ff;
    text-decoration: none;
    padding: 12px 14px;
    border-radius: 14px;
    font-weight: 700;
    transition: 0.2s;
  }

  .sidebar a:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .user-box {
    margin-bottom: 12px;
  }

  .user-name {
    font-size: 14px;
    font-weight: 800;
    color: #e5e7eb;
  }

  .user-role {
    margin-top: 4px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    color: #94a3b8;
  }

  .logout-btn {
    width: 100%;
    height: 42px;
    padding: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(220, 38, 38, 0.14);
    color: #fecaca !important;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
  }

  .logout-btn:hover {
    background: #dc2626 !important;
    color: white !important;
  }
</style>
