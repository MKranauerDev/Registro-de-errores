generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  SUPERVISOR
  CONTROLADOR
  CONSULTA
}

enum ResultadoControl {
  FALTANTE
  SOBRANTE
  SIN_ERROR_BASE
}

model Picker {
  id                Int                       @id @default(autoincrement())
  nombre            String                    @unique
  activo            Boolean                   @default(true)
  relevamientos     Relevamiento[]
  asignaciones      EstacionPickerHistorial[]
  jornadas          PickerJornada[]
  equipoHabitual    EquipoHabitual[]
  relevamientoItems RelevamientoItem[]
}

model Estacion {
  id                Int                       @id @default(autoincrement())
  codigo            String                    @unique
  activo            Boolean                   @default(true)
  relevamientos     Relevamiento[]
  asignaciones      EstacionPickerHistorial[]
  jornadas          PickerJornada[]
  equipoHabitual    EquipoHabitual?
  relevamientoItems RelevamientoItem[]
}

model EstacionPickerHistorial {
  id         Int       @id @default(autoincrement())
  estacionId Int
  pickerId   Int
  fechaDesde DateTime  @default(now())
  fechaHasta DateTime?
  esActual   Boolean   @default(true)

  estacion Estacion @relation(fields: [estacionId], references: [id])
  picker   Picker   @relation(fields: [pickerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estacionId, esActual])
}

model Controlador {
  id            Int                @id @default(autoincrement())
  nombre        String             @unique
  activo        Boolean            @default(true)
  relevamientos Relevamiento[]
  casos         RelevamientoCaso[]
  usuarios      Usuario[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Sku {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  descripcion String?

  width      Float?
  depth      Float?
  height     Float?
  cubicaje   Float?
  pesoBranch Float?
  piezasCaja Int?

  imagenUrl String?

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relevamientos     Relevamiento[]
  posiciones        SkuPosicionHistorial[]
  relevamientoItems RelevamientoItem[]
}

enum EstadoSkuLinea {
  EN_LINEA
  FUERA_DE_LINEA
}

model SkuPosicionHistorial {
  id            Int            @id @default(autoincrement())
  skuId         Int
  posicion      String?
  estado        EstadoSkuLinea @default(EN_LINEA)
  fechaDesde    DateTime       @default(now())
  fechaHasta    DateTime?
  esActual      Boolean        @default(true)
  motivoCambio  String?
  usuarioCambio String?

  sku Sku @relation(fields: [skuId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skuId, esActual])
  @@index([estado])
}

model Relevamiento {
  id               Int              @id @default(autoincrement())
  fechaCarga       DateTime         @default(now())
  mesOperativo     String
  remito           String
  cbi              String
  resultadoControl ResultadoControl
  cantidad         Int              @default(1)
  observacion      String?

  estacionId    Int
  pickerId      Int
  skuId         Int
  controladorId Int

  posicionSkuAlMomento String?
  estadoSkuAlMomento   EstadoSkuLinea?
  pickerAlMomento      String?
  controladorAlMomento String?

  estacion    Estacion    @relation(fields: [estacionId], references: [id])
  picker      Picker      @relation(fields: [pickerId], references: [id])
  sku         Sku         @relation(fields: [skuId], references: [id])
  controlador Controlador @relation(fields: [controladorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoBloqueLinea {
  PRODUCCION
  DESCANSO
  MANTENIMIENTO
  SIN_ORDENES
  PARADA_OPERATIVA
}

enum Transporte {
  OCA
  URBANO
  ANDREANI
  CDS
}

model JornadaLinea {
  id           Int      @id @default(autoincrement())
  fecha        DateTime
  mesOperativo String
  observacion  String?

  bloques      BloqueLinea[]
  pickersLinea PickerJornada[]
  produccion   ProduccionTransporte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BloqueLinea {
  id          Int             @id @default(autoincrement())
  jornadaId   Int
  tipo        TipoBloqueLinea
  horaInicio  DateTime
  horaFin     DateTime?
  observacion String?

  jornada JornadaLinea @relation(fields: [jornadaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PickerJornada {
  id         Int @id @default(autoincrement())
  jornadaId  Int
  pickerId   Int
  estacionId Int

  horaDesde DateTime?
  horaHasta DateTime?
  activo    Boolean   @default(true)

  jornada  JornadaLinea @relation(fields: [jornadaId], references: [id])
  picker   Picker       @relation(fields: [pickerId], references: [id])
  estacion Estacion     @relation(fields: [estacionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProduccionTransporte {
  id         Int        @id @default(autoincrement())
  jornadaId  Int
  transporte Transporte
  cantidad   Int        @default(0)
  pallets    Int?

  jornada JornadaLinea @relation(fields: [jornadaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jornadaId, transporte])
}

model EquipoHabitual {
  id Int @id @default(autoincrement())

  estacionId Int @unique
  pickerId   Int

  estacion Estacion @relation(fields: [estacionId], references: [id])

  picker Picker @relation(fields: [pickerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model RelevamientoCaso {
  id             Int      @id @default(autoincrement())
  fechaCarga     DateTime @default(now())
  fechaHoraError DateTime @default(now())

  mesOperativo String
  remito       String
  cbi          String
  observacion  String?

  controladorId Int
  controlador   Controlador @relation(fields: [controladorId], references: [id])

  items RelevamientoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RelevamientoItem {
  id Int @id @default(autoincrement())

  casoId     Int
  skuId      Int
  estacionId Int
  pickerId   Int

  resultadoControl ResultadoControl
  cantidad         Int              @default(1)

  posicionSkuAlMomento String?
  estadoSkuAlMomento   EstadoSkuLinea?
  pickerAlMomento      String?

  caso     RelevamientoCaso @relation(fields: [casoId], references: [id])
  sku      Sku              @relation(fields: [skuId], references: [id])
  estacion Estacion         @relation(fields: [estacionId], references: [id])
  picker   Picker           @relation(fields: [pickerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {

  id Int @id @default(autoincrement())

  nombre String

  email String @unique

  password String

  rol RolUsuario @default(CONTROLADOR)

  activo Boolean @default(true)

  controladorId Int?

  controlador Controlador? @relation(fields: [controladorId], references: [id])

  ultimoAcceso DateTime?

  debeCambiarPassword Boolean @default(true)

  intentosFallidos Int @default(0)

  bloqueadoHasta DateTime?

  auditorias Auditoria[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  modulo    String
  accion    String
  detalle   String?
  fecha     DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}